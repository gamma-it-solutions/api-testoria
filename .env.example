# ── Testoria API — Environment Template ───────────────────────────────
# Copy to .env and fill in the values.
# See .env.local (dev defaults) and .env.prod (production template).

# Database
DATABASE_URL=postgresql+asyncpg://testoria:testoria@localhost:5434/testoria
TEST_DATABASE_URL=postgresql+asyncpg://testoria:testoria@localhost:5433/testoria_test

# Security
SECRET_KEY=change-me-to-a-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Redis
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6380/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File storage
UPLOAD_DIR=uploads

# Object storage (MinIO — see docker-compose.yml)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ATTACHMENTS=testoria-attachments
# Override only if presigned URLs need a different hostname (typical in prod
# when the API talks to MinIO over the docker network but browsers go via the
# reverse proxy). Leave unset for local dev.
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.com

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Initial admin seed (scripts/seed.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@testoria.local
ADMIN_PASSWORD=

# Centrifugo
CENTRIFUGO_URL=http://localhost:8001
CENTRIFUGO_API_KEY=centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=centrifugo-token-secret

# Email (Gmail SMTP + App Password) — see docs/03-engineering/operations/email.md
# Leave EMAIL_ENABLED=false in dev/test: outbox rows still queue and drain, the
# SMTP send is a logged no-op so nothing hits Gmail.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
# Gmail App Password (16 chars, no spaces) — NOT the account password.
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=Testoria <no-reply@testoria.local>
# Public frontend base URL — used to build set-password / reset links.
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_INVITE_TOKEN_TTL_SECONDS=86400
EMAIL_RESET_TOKEN_TTL_SECONDS=3600
EMAIL_OUTBOX_POLL_SECONDS=10
EMAIL_OUTBOX_BATCH_SIZE=50
EMAIL_SEND_PACE_MS=200
EMAIL_MAX_ATTEMPTS=5

# Debug
DEBUG=false
